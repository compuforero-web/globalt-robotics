[Unit]
Description=Actualizar GLOBALT Robotics desde GitHub
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=globalt-robotics
Group=globalt-robotics
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/python3 /usr/local/lib/globalt-robotics/update.py
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/globalt-robotics /srv/globalt-robotics
