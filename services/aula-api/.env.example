# Copia a .env y ajusta. Este archivo NO contiene secretos reales.
# Contraseña de la base de desarrollo local: genera una propia, p. ej. `openssl rand -hex 24`.
AULA_DB_CLAVE=cambia-esta-clave-local
# Puerto local (solo 127.0.0.1) donde nginx de desarrollo sirve /aula y /api/aula.
AULA_PUERTO_LOCAL=8180
# Orígenes permitidos para peticiones que modifican datos (coma entre varios).
AULA_ORIGENES=http://127.0.0.1:8180,http://localhost:8180
# En desarrollo por HTTP debe ser false; en producción (HTTPS) siempre true.
AULA_COOKIE_SEGURA=false
AULA_SESION_INACTIVIDAD_MIN=120
AULA_SESION_MAX_HORAS=168
AULA_MAX_FALLOS_CORREO=5
AULA_MAX_FALLOS_IP=30
AULA_MAX_REGISTROS_IP=10
AULA_VENTANA_INTENTOS_MIN=15
# Registro público de adultos. Cerrado por defecto: las cuentas se crean con `python -m app.cuentas`.
# Aunque sea true, solo se abre con correo configurado y ambos documentos vigentes. En desarrollo el correo va
# al buzón de pruebas local (servicio «buzon», mensajes en dev/buzon/) y se cargan textos de PRUEBA.
AULA_REGISTRO_ABIERTO=true
# Base de los enlaces de los correos de desarrollo.
AULA_URL_PUBLICA=http://127.0.0.1:8180
